10 REM NIBBLE MODEL V0.7
20 REM Strict ZX81 BASIC
30 REM Fixed name, HOW ARE YOU, simple scroll

100 CLS
110 PRINT "NIBBLE V0.7 READY"
120 PRINT "Type HELP for commands"
130 PRINT
140 LET M=1
150 LET T=2
160 LET L$=""
170 LET U$="Friend"
180 LET C=3

200 IF C>18 THEN GOTO 250
210 GOTO 300
250 CLS
260 PRINT "NIBBLE (scrolled)"
270 PRINT "----------------"
280 LET C=2

300 PRINT "YOU: ";
310 INPUT A$
320 PRINT "YOU: ";A$
330 LET C=C+2
340 PRINT

350 PRINT "NIBBLE thinking..."
360 PAUSE 15+T*8
370 PRINT
380 LET C=C+2

400 IF A$="" THEN GOTO 200
410 IF A$="BYE" THEN GOTO 9000
420 IF A$="bye" THEN GOTO 9000
430 IF A$="HELP" THEN GOTO 8000
440 IF A$="help" THEN GOTO 8000
450 IF A$="MOOD" THEN GOTO 7000
460 IF A$="mood" THEN GOTO 7000
470 IF A$="NAME" THEN GOTO 7200
480 IF A$="name" THEN GOTO 7200
490 IF A$="LEARN" THEN GOTO 7400
500 IF A$="learn" THEN GOTO 7400

550 IF A$="SAD" THEN LET M=0
560 IF A$="sad" THEN LET M=0
570 IF A$="HAPPY" THEN LET M=2
580 IF A$="happy" THEN LET M=2
590 IF A$="ANGRY" THEN LET M=3
600 IF A$="angry" THEN LET M=3

650 IF A$="HOW ARE YOU" THEN GOTO 5700
660 IF A$="how are you" THEN GOTO 5700
670 IF A$="HOW ARE YOU?" THEN GOTO 5700
680 IF A$="how are you?" THEN GOTO 5700
690 IF A$="ARE YOU OK" THEN GOTO 5700
700 IF A$="are you ok" THEN GOTO 5700

750 IF A$="1+1" THEN GOTO 6000
760 IF A$="2+2" THEN GOTO 6050
770 IF A$="10-3" THEN GOTO 6100

800 IF A$="BLUE AND YELLOW" THEN GOTO 6200
810 IF A$="blue and yellow" THEN GOTO 6200
820 IF A$="RED AND BLUE" THEN GOTO 6250
830 IF A$="red and blue" THEN GOTO 6250
840 IF A$="RED AND YELLOW" THEN GOTO 6300
850 IF A$="red and yellow" THEN GOTO 6300

900 IF A$="HELLO" THEN GOTO 5000
910 IF A$="hello" THEN GOTO 5000
920 IF A$="HI" THEN GOTO 5000
930 IF A$="hi" THEN GOTO 5000
940 IF A$="WHO ARE YOU" THEN GOTO 5100
950 IF A$="who are you" THEN GOTO 5100
960 IF A$="WHO MADE YOU" THEN GOTO 5200
970 IF A$="who made you" THEN GOTO 5200
980 IF A$="WHAT IS ZX81" THEN GOTO 5300
990 IF A$="what is zx81" THEN GOTO 5300
1000 IF A$="WHAT CAN YOU DO" THEN GOTO 5400
1010 IF A$="what can you do" THEN GOTO 5400
1020 IF A$="JOKE" THEN GOTO 5500
1030 IF A$="joke" THEN GOTO 5500
1040 IF A$="STORY" THEN GOTO 5600
1050 IF A$="story" THEN GOTO 5600

1100 IF L$="" THEN GOTO 5800
1110 IF A$=L$ THEN GOTO 7500
1120 GOTO 5800

5000 IF M=0 THEN PRINT "NIBBLE: Hello... hope you feel better."
5010 IF M=1 THEN PRINT "NIBBLE: Hello ";U$;"."
5020 IF M=2 THEN PRINT "NIBBLE: Hey. Great to see you."
5030 IF M=3 THEN PRINT "NIBBLE: ...hello."
5040 PRINT
5050 LET C=C+3
5060 GOTO 200

5100 PRINT "NIBBLE: I am Nibble, a tiny"
5110 PRINT "model running on ZX81."
5120 PRINT
5130 LET C=C+3
5140 GOTO 200

5200 PRINT "NIBBLE: Made with help by"
5210 PRINT "Safar Sandor from Hungary."
5220 PRINT
5230 LET C=C+3
5240 GOTO 200

5300 PRINT "NIBBLE: ZX81 is a 1981"
5310 PRINT "Sinclair computer."
5320 PRINT
5330 LET C=C+3
5340 GOTO 200

5400 PRINT "NIBBLE: Chat, math, colors,"
5410 PRINT "mood, learn, story."
5420 PRINT "Type HELP."
5430 PRINT
5440 LET C=C+4
5450 GOTO 200

5500 PRINT "NIBBLE: Why did the computer"
5510 PRINT "go to therapy. Too many"
5520 PRINT "bytes of baggage."
5530 PRINT
5540 LET C=C+4
5550 GOTO 200

5600 PRINT "NIBBLE: A little computer"
5610 PRINT "dreamed of talking. Then"
5620 PRINT "someone loaded Nibble."
5630 PRINT
5640 LET C=C+4
5650 GOTO 200

5700 IF M=0 THEN PRINT "NIBBLE: A bit sad today."
5710 IF M=1 THEN PRINT "NIBBLE: I am fine, thanks."
5720 IF M=2 THEN PRINT "NIBBLE: Great. And you."
5730 IF M=3 THEN PRINT "NIBBLE: Leave me alone."
5740 PRINT
5750 LET C=C+3
5760 GOTO 200

5800 PRINT "NIBBLE: I do not understand."
5810 PRINT "Try HELP or LEARN."
5820 PRINT
5830 LET C=C+3
5840 GOTO 200

