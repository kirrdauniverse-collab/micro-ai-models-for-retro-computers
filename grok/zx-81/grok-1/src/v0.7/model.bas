6250 PRINT "NIBBLE: Red+Blue=Purple"
6260 PRINT
6270 LET C=C+2
6280 GOTO 200

6300 PRINT "NIBBLE: Red+Yellow=Orange"
6310 PRINT
6320 LET C=C+2
6330 GOTO 200

7000 PRINT "NIBBLE: Mood code: ";M
7010 PRINT "0=sad 1=ok 2=happy 3=angry"
7020 PRINT
7030 LET C=C+3
7040 GOTO 200

7200 PRINT "NIBBLE: Your name?"
7210 INPUT U$
7220 IF U$="" THEN LET U$="Friend"
7230 PRINT "NIBBLE: Hi, ";U$
7240 PRINT
7250 LET C=C+3
7260 GOTO 200

7400 PRINT "NIBBLE: Teach me one fact."
7410 INPUT L$
7420 IF LEN L$>20 THEN LET L$=L$( TO 20)
7430 PRINT "NIBBLE: Remembered."
7440 PRINT
7450 LET C=C+3
7460 GOTO 200

7500 PRINT "NIBBLE: You taught me:"
7510 PRINT L$
7520 PRINT
7530 LET C=C+3
7540 GOTO 200

8000 PRINT "HELP: BYE NAME MOOD LEARN"
8010 PRINT "hello, how are you,"
8020 PRINT "who are you, joke, story"
8030 PRINT "1+1, blue and yellow"
8040 PRINT
8050 LET C=C+5
8060 GOTO 200

9000 PRINT "NIBBLE: Goodbye ";U$;"."
9010 PRINT
9020 STOP
